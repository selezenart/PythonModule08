# Copy this file to .env and fill in real values.
#   cp .env.example .env
# The .env file is git-ignored so real secrets never reach version control.

# "development" or "production"
MATRIX_MODE=development

# Connection string for data storage
DATABASE_URL=postgresql://neo:changeme@localhost:5432/matrix

# Secret key for external services (use a placeholder here, real key only in .env)
API_KEY=your-secret-api-key-here

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# URL for the resistance network
ZION_ENDPOINT=https://zion.local/api
